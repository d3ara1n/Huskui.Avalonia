<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(HuskuiTargetFrameworks)</TargetFrameworks>
        <PackageId>Huskui.Avalonia.Code</PackageId>
        <Authors>d3ara1n</Authors>
        <Company>d3ara1n</Company>
        <Product>Huskui.Avalonia</Product>
        <Description>Syntax-highlighted code viewer extension for Huskui.Avalonia, powered by TextMate grammars.</Description>
        <PackageTags>avalonia;code;syntax-highlighting;textmate;ui;controls;huskui</PackageTags>
        <PackageProjectUrl>https://github.com/d3ara1n/Huskui.Avalonia</PackageProjectUrl>
        <RepositoryUrl>https://github.com/d3ara1n/Huskui.Avalonia</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Title>Huskui.Avalonia.Code</Title>
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Huskui.Avalonia\Huskui.Avalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DiffPlex" />
        <PackageReference Include="TextMateSharp" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <!--  Self-hosted TextMate grammar snapshot; see docs/grammar-assets.md  -->
        <EmbeddedResource
            Include="Assets\Grammars\*.json.gz"
            LogicalName="Huskui.Grammars.%(Filename)%(Extension)" />
        <EmbeddedResource
            Include="Assets\Grammars\manifest.json"
            LogicalName="Huskui.Grammars.manifest.json" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
