<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia">
    <Design.PreviewWith>
        <Panel Background="White">
            <StackPanel
                Margin="24"
                Orientation="Horizontal">
                <husk:StepControl>
                    <husk:StepItem Header="Step 1">
                        <TextBlock Text="Step 1" />
                    </husk:StepItem>
                    <husk:StepItem Header="Step 2">
                        <TextBlock Text="Step 2" />
                    </husk:StepItem>
                    <husk:StepItem Header="Step 3">
                        <TextBlock Text="Step 3" />
                    </husk:StepItem>
                </husk:StepControl>
            </StackPanel>
        </Panel>
    </Design.PreviewWith>

    <ControlTheme
        x:Key="{x:Type husk:StepItem}"
        TargetType="husk:StepItem">
        <Setter Property="MinWidth" Value="124" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{StaticResource MediumCornerRadius}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid
                    RowDefinitions="Auto,*"
                    RowSpacing="8">
                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="*,Auto,*">
                        <Border
                            Name="LeftConnector"
                            Grid.Column="0"
                            Height="4"
                            Background="{StaticResource ControlBorderBrush}"
                            IsVisible="{TemplateBinding IsFirst,
                                                        Converter={x:Static BoolConverters.Not}}" />
                        <Border
                            Name="Circle"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            BorderBrush="{StaticResource ControlAccentBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource FullCornerRadius}">
                            <Panel>
                                <fi:SymbolIcon
                                    Name="Checkmark"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource LargeFontSize}"
                                    IsVisible="False"
                                    Symbol="Checkmark" />
                                <TextBlock
                                    Name="Index"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource LargeFontSize}"
                                    Text="{TemplateBinding Index,
                                                           Converter={x:Static husk:InternalConverters.ToDisplayIndex}}" />
                            </Panel>
                        </Border>
                        <Border
                            Name="RightConnector"
                            Grid.Column="2"
                            Height="4"
                            Background="{StaticResource ControlBorderBrush}"
                            IsVisible="{TemplateBinding IsLast,
                                                        Converter={x:Static BoolConverters.Not}}" />
                    </Grid>
                    <Panel
                        Grid.Row="1"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <Border
                            Name="Highlight"
                            IsVisible="{TemplateBinding IsSelected}"
                            Background="{StaticResource ControlAccentTranslucentHalfBackgroundBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <Grid
                            Margin="{TemplateBinding Padding}"
                            RowDefinitions="Auto,*">
                            <ContentPresenter
                                Grid.Row="0"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}">
                                <ContentPresenter.Styles>
                                    <Style Selector="ContentPresenter &gt; TextBlock">
                                        <Setter Property="FontSize" Value="{StaticResource LargeFontSize}" />
                                        <Setter Property="FontWeight" Value="{StaticResource ControlStrongFontWeight}" />
                                    </Style>
                                </ContentPresenter.Styles>
                            </ContentPresenter>
                            <ContentPresenter
                                Grid.Row="1"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}">
                                <ContentPresenter.Styles>
                                    <Style Selector="ContentPresenter &gt; TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ControlSecondaryForegroundBrush}" />
                                    </Style>
                                </ContentPresenter.Styles>
                            </ContentPresenter>
                        </Grid>
                    </Panel>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:selected /template/ Border#LeftConnector, ^:completed /template/ Border#LeftConnector">
            <Setter Property="Background" Value="{StaticResource ControlAccentBorderBrush}" />
        </Style>
        <Style Selector="^:completed /template/ Border#RightConnector">
            <Setter Property="Background" Value="{StaticResource ControlAccentBorderBrush}" />
        </Style>
        <Style Selector="^:completed /template/ Border#Circle">
            <Setter Property="Background" Value="{StaticResource ControlAccentBackgroundBrush}" />
        </Style>
        <Style Selector="^:completed /template/ fi|SymbolIcon#Checkmark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:completed /template/ TextBlock#Index">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ControlDisabledForegroundBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Circle">
            <Setter Property="BorderBrush" Value="{StaticResource ControlDisabledBorderBrush}" />
        </Style>
        <Style Selector="^:disabled:completed /template/ Border#Circle">
            <Setter Property="Background" Value="{StaticResource ControlDisabledInteractiveBackgroundBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ fi|SymbolIcon#Checkmark">
            <Setter Property="Foreground" Value="{StaticResource ControlDisabledForegroundBrush}" />
        </Style>
        <Style Selector="^:disabled:selected /template/ Border#LeftConnector, ^:disabled:completed /template/ Border#LeftConnector, ^:disabled:completed /template/ Border#RightConnector">
            <Setter Property="Background" Value="{StaticResource ControlDisabledBorderBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Highlight">
            <Setter Property="Background" Value="{StaticResource ControlTranslucentHalfBackgroundBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        x:Key="MinimalStepItemTheme"
        TargetType="husk:StepItem">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Ellipse
                    x:Name="Indicator"
                    Width="8"
                    Height="8"
                    Fill="{StaticResource TransparentBrush}"
                    Stroke="{StaticResource ControlAccentBorderBrush}"
                    StrokeThickness="1.5" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^:completed /template/ Ellipse#Indicator">
            <Setter Property="Fill" Value="{StaticResource ControlAccentBackgroundBrush}" />
        </Style>

        <Style Selector="^:selected /template/ Ellipse#Indicator">
            <Setter Property="Fill" Value="{StaticResource ControlAccentForegroundBrush}" />
        </Style>

        <Style Selector="^:disabled /template/ Ellipse#Indicator">
            <Setter Property="Stroke" Value="{StaticResource ControlDisabledBorderBrush}" />
        </Style>
        <Style Selector="^:disabled:completed /template/ Ellipse#Indicator, ^:disabled:selected /template/ Ellipse#Indicator">
            <Setter Property="Fill" Value="{StaticResource ControlDisabledInteractiveBackgroundBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
