<husk:Drawer
    x:Class="Huskui.Gallery.Drawers.ComposeMailDrawer"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="New message"
    MinHeight="320"
    MaxWidth="640"
    MaxHeight="560"
    Padding="16"
    mc:Ignorable="d">

    <Grid
        RowDefinitions="Auto,*,Auto"
        RowSpacing="12">
        <StackPanel Spacing="8">
            <TextBox
                x:Name="ToBox"
                PlaceholderText="name@example.com">
                <TextBox.InnerLeftContent>
                    <TextBlock
                        Width="64"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="To" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <TextBox PlaceholderText="Optional">
                <TextBox.InnerLeftContent>
                    <TextBlock
                        Width="64"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="Cc" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <TextBox
                x:Name="SubjectBox"
                PlaceholderText="What is this about?"
                TextChanged="OnSubjectChanged">
                <TextBox.InnerLeftContent>
                    <TextBlock
                        Width="64"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="Subject" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </StackPanel>

        <TextBox
            x:Name="BodyBox"
            Grid.Row="1"
            VerticalContentAlignment="Top"
            Classes="Multiline"
            PlaceholderText="Write your message..." />

        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,*,Auto">
            <Button
                Click="OnDiscardClick"
                Theme="{StaticResource GhostButtonTheme}">
                <husk:IconLabel
                    Icon="Delete"
                    Text="Discard" />
            </Button>
            <Button
                Grid.Column="2"
                IsEnabled="{Binding #ToBox.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Classes="Primary"
                Click="OnSendClick">
                <husk:IconLabel
                    Icon="Send"
                    Text="Send" />
            </Button>
        </Grid>
    </Grid>
</husk:Drawer>
