<controls:ControlPage
    x:Class="Huskui.Gallery.Views.ToggleButtonsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Huskui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Spacing="32">

        <controls:ExampleContainer
            Title="Basic ToggleButtons"
            Description="Standard toggle buttons with different states">
            <StackPanel
                Width="300"
                Spacing="16">
                <ToggleButton Content="Unchecked" />
                <ToggleButton
                    Content="Checked"
                    IsChecked="True" />
                <ToggleButton
                    Content="Indeterminate"
                    IsChecked="{x:Null}"
                    IsThreeState="True" />
                <ToggleButton
                    IsEnabled="False"
                    Content="Disabled Unchecked" />
                <ToggleButton
                    IsEnabled="False"
                    Content="Disabled Checked"
                    IsChecked="True" />
                <ToggleButton
                    IsEnabled="False"
                    Content="Disabled Indeterminate"
                    IsChecked="{x:Null}"
                    IsThreeState="True" />
            </StackPanel>
        </controls:ExampleContainer>

        <controls:ExampleContainer
            Title="Ghost ToggleButtons"
            Description="Borderless toggle buttons that reveal chrome only when checked">
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="32">
                <StackPanel
                    Grid.Column="0"
                    Spacing="12">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Text="Enabled" />
                    <ToggleButton
                        Content="Ghost Unchecked"
                        Theme="{StaticResource GhostToggleButtonTheme}" />
                    <ToggleButton
                        Content="Ghost Checked"
                        IsChecked="True"
                        Theme="{StaticResource GhostToggleButtonTheme}" />
                    <ToggleButton
                        Content="Ghost Indeterminate"
                        IsChecked="{x:Null}"
                        IsThreeState="True"
                        Theme="{StaticResource GhostToggleButtonTheme}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Spacing="12">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Text="Disabled" />
                    <ToggleButton
                        IsEnabled="False"
                        Content="Ghost Unchecked"
                        Theme="{StaticResource GhostToggleButtonTheme}" />
                    <ToggleButton
                        IsEnabled="False"
                        Content="Ghost Checked"
                        IsChecked="True"
                        Theme="{StaticResource GhostToggleButtonTheme}" />
                    <ToggleButton
                        IsEnabled="False"
                        Content="Ghost Indeterminate"
                        IsChecked="{x:Null}"
                        IsThreeState="True"
                        Theme="{StaticResource GhostToggleButtonTheme}" />
                </StackPanel>
            </Grid>
        </controls:ExampleContainer>

        <controls:ExampleContainer
            Title="Sizes"
            Description="Small variants for compact layouts">
            <StackPanel
                Orientation="Horizontal"
                Spacing="12">
                <ToggleButton
                    Classes="Small"
                    Content="Small" />
                <ToggleButton
                    Classes="Small"
                    Content="Small Checked"
                    IsChecked="True" />
                <ToggleButton
                    Classes="Small"
                    Content="Small Ghost Checked"
                    IsChecked="True"
                    Theme="{StaticResource GhostToggleButtonTheme}" />
            </StackPanel>
        </controls:ExampleContainer>

    </StackPanel>
</controls:ControlPage>
