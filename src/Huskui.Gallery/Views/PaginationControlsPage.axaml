<controls:ControlPage
    x:Class="Huskui.Gallery.Views.PaginationControlsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Huskui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Spacing="32">

        <Border
            Padding="24"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource MediumCornerRadius}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="{StaticResource LargeFontSize}"
                        FontWeight="{StaticResource ControlStrongFontWeight}"
                        Text="PaginationControl overview" />
                    <TextBlock
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="Paginated navigation with page-number buttons, prev/next arrows, and a quick-jump popup (click the ellipsis)."
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock TextWrapping="Wrap">
                    <Run Text="The current page is exposed twice: " />
                    <husk:HighlightInline Text="PageIndex" />
                    <Run Text=" is the 0-based authoritative state — bind or observe it to drive data-loading logic (e.g. " />
                    <husk:HighlightInline Text="items.Skip(PageIndex * PageSize).Take(PageSize)" />
                    <Run Text="), while " />
                    <husk:HighlightInline Text="DisplayIndex" />
                    <Run Text=" is the 1-based number shown on the buttons and in status readouts. " />
                    <husk:HighlightInline Text="IndexChanged" />
                    <Run Text=" fires after the page actually changes; changing " />
                    <husk:HighlightInline Text="TotalCount" />
                    <Run Text=" or " />
                    <husk:HighlightInline Text="PageSize" />
                    <Run Text=" can coerce " />
                    <husk:HighlightInline Text="PageIndex" />
                    <Run Text=" into range, which raises it as well." />
                </TextBlock>
            </StackPanel>
        </Border>

        <controls:ExampleContainer
            Title="Basic Pagination"
            Description="Default settings; every navigation path is logged through IndexChanged">
            <controls:ExampleContainer.Controls>
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="Navigation" />
                    <Button
                        Click="OnGoToFirst"
                        Content="Go to First" />
                    <Button
                        Click="OnGoToLast"
                        Content="Go to Last" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="The GoTo* methods, the arrows and the page-number buttons all end up in the log below."
                        TextWrapping="Wrap" />
                </StackPanel>
            </controls:ExampleContainer.Controls>
            <StackPanel Spacing="12">
                <husk:PaginationControl
                    x:Name="BasicPagination"
                    TotalCount="100" />
                <TextBlock>
                    <Run Text="PageIndex: " />
                    <Run Text="{Binding #BasicPagination.PageIndex}" />
                    <Run Text=" · Page: " />
                    <Run Text="{Binding #BasicPagination.DisplayIndex}" />
                    <Run Text=" / " />
                    <Run Text="{Binding #BasicPagination.PageCount}" />
                </TextBlock>
                <ItemsControl
                    x:Name="IndexChangedLog"
                    FontSize="12"
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}" />
            </StackPanel>
        </controls:ExampleContainer>

        <controls:ExampleContainer
            Title="Large Dataset"
            Description="Many pages collapse into an ellipsis; click it to open the quick-jump popup">
            <controls:ExampleContainer.Controls>
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="Jump To" />
                    <Button
                        Click="OnGoToPage20"
                        Content="Go to Page 20" />
                    <Button
                        Click="OnGoToPage50"
                        Content="Go to Page 50" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="The buttons assign 0-based PageIndex directly: 19 lands on the button labeled 20."
                        TextWrapping="Wrap" />
                </StackPanel>
            </controls:ExampleContainer.Controls>
            <StackPanel Spacing="12">
                <husk:PaginationControl
                    x:Name="LargePagination"
                    TotalCount="1000"
                    PageSize="10" />
                <TextBlock>
                    <Run Text="Page: " />
                    <Run Text="{Binding #LargePagination.DisplayIndex}" />
                    <Run Text=" / " />
                    <Run Text="{Binding #LargePagination.PageCount}" />
                </TextBlock>
            </StackPanel>
        </controls:ExampleContainer>

        <controls:ExampleContainer
            Title="Custom PageSize"
            Description="Changing PageSize recomputes PageCount and coerces PageIndex back into range">
            <controls:ExampleContainer.Controls>
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="PageSize" />
                    <NumericUpDown
                        x:Name="PageSizeUpDown"
                        Maximum="100"
                        Minimum="1"
                        Value="25" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="Raise the page size until the current page disappears — PageIndex is coerced to the last page and IndexChanged fires."
                        TextWrapping="Wrap" />
                </StackPanel>
            </controls:ExampleContainer.Controls>
            <StackPanel Spacing="12">
                <husk:PaginationControl
                    x:Name="CustomPagination"
                    TotalCount="200"
                    PageSize="{Binding #PageSizeUpDown.Value, Mode=OneWay}" />
                <TextBlock>
                    <Run Text="Page: " />
                    <Run Text="{Binding #CustomPagination.DisplayIndex}" />
                    <Run Text=" | PageSize: " />
                    <Run Text="{Binding #CustomPagination.PageSize}" />
                    <Run Text=" | PageCount: " />
                    <Run Text="{Binding #CustomPagination.PageCount}" />
                </TextBlock>
            </StackPanel>
        </controls:ExampleContainer>

        <controls:ExampleContainer
            Title="Disabled State"
            Description="PaginationControl can be disabled to prevent user interaction">
            <controls:ExampleContainer.Controls>
                <StackPanel Spacing="12">
                    <ToggleSwitch
                        IsChecked="True"
                        OnContent="Enabled"
                        OffContent="Disabled"
                        IsCheckedChanged="OnEnabledToggled" />
                </StackPanel>
            </controls:ExampleContainer.Controls>
            <husk:PaginationControl
                x:Name="DisabledPagination"
                TotalCount="50"
                PageSize="10" />
        </controls:ExampleContainer>

    </StackPanel>
</controls:ControlPage>
